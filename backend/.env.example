# Copy to backend/.env (gitignored) and fill in. Either key name works.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-south1

# Force canned fixtures even when credentials exist:
# LALFITA_OFFLINE=1

# Pathfinder's Google Search grounding (paid tier / Vertex only; free-tier
# keys 429). Auto-on under Vertex, off otherwise:
# GEMINI_SEARCH_GROUNDING=1

# One bureaucratic "day" in wall-clock seconds (demo pacing):
# SIM_DAY_SECONDS=3

# Push notifications (F8): a ntfy.sh topic (subscribe in the ntfy phone app)
# and/or a Slack/Discord-style incoming webhook URL:
# NTFY_TOPIC=lalfita-meera-demo
# NOTIFY_WEBHOOK_URL=

# Disable the crash-drill endpoint (enabled by default for the demo):
# LALFITA_DEMO_CONTROLS=0
